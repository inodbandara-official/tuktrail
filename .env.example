# Copy to .env and fill in. Never commit .env.
# Values below work out of the box with `docker compose up -d` for local dev.

# ── App ────────────────────────────────────────────────────────────────
# Public origin of the web app (used for auth callbacks, OG images, sitemap).
APP_URL=http://localhost:3000
# Set to "true" to show the /design tokens page in production builds.
ENABLE_DESIGN_PAGE=false

# ── Database (PostgreSQL + PostGIS) ────────────────────────────────────
DATABASE_URL=postgres://tuktrail:tuktrail@localhost:5544/tuktrail
# Used by integration and e2e tests only.
TEST_DATABASE_URL=postgres://tuktrail:tuktrail@localhost:5544/tuktrail_test
# docker-compose only
POSTGRES_USER=tuktrail
POSTGRES_PASSWORD=tuktrail
POSTGRES_DB=tuktrail
POSTGRES_HOST_PORT=5544

# ── Object storage (S3-compatible: RustFS locally, Cloudflare R2 or AWS S3 in prod) ──
# R2: https://<account-id>.r2.cloudflarestorage.com   S3: leave empty to use AWS default
S3_ENDPOINT=http://localhost:9000
# R2 uses "auto"
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tuktrail-dev
S3_SECRET_ACCESS_KEY=tuktrail-dev-secret
# true for RustFS/MinIO, false for R2/S3
S3_FORCE_PATH_STYLE=true
# Private bucket: raw uploads awaiting processing. Never publicly readable.
S3_PRIVATE_BUCKET=tuktrail-private
# Public bucket: processed, EXIF-stripped images.
S3_PUBLIC_BUCKET=tuktrail-public
# Base URL that serves S3_PUBLIC_BUCKET objects (R2 custom domain / CloudFront / local).
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/tuktrail-public

# ── Auth (Better Auth) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (redirect URI: <APP_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email of the user seeded with role=admin (signs in via magic link).
SEED_ADMIN_EMAIL=admin@example.com

# ── Email (magic links) ────────────────────────────────────────────────
# Local: Mailpit (UI http://localhost:8025). Prod: any SMTP provider.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TukTrail <no-reply@tuktrail.lk>"
# Mailpit API, used by e2e tests to read magic links.
MAILPIT_URL=http://localhost:8025

# ── Maps ───────────────────────────────────────────────────────────────
# None needed: MapLibre GL JS + OpenFreeMap vector tiles (no API key, no billing).
# Themed styles are self-hosted in public/map/ (regenerate with `pnpm map:styles`).

# ── Uploads ────────────────────────────────────────────────────────────
UPLOAD_MAX_FILES=5
UPLOAD_MAX_BYTES=10485760
UPLOAD_SUBMISSIONS_PER_DAY=10
